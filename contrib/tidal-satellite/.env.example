# Tidal satellite settings — copy to .env and edit.

# snapMULTI server running the `tidal-relay` profile (host name or IP).
# An IP is more robust than <name>.local if mDNS is flaky on your LAN.
TIDAL_RELAY_SERVER=

# Name shown in the Tidal app (default: "<this Pi's hostname> Tidal").
#TIDAL_NAME=Living Room Tidal

# Image set — use the same value as IMAGE_TAG in the server's /opt/snapmulti/.env.
IMAGE_TAG=latest

#TZ=Europe/Rome
