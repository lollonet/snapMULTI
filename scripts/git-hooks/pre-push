#!/usr/bin/env bash
# Pre-push hook - runs CI checks before pushing
# Mirrors validate.yml gates for local/remote parity, including the
# pinned ruff and hadolint versions read from validate.yml.
# Install: ln -sf ../../scripts/git-hooks/pre-push .git/hooks/pre-push
# Bypass with: git push --no-verify
# Debug: scripts/git-hooks/pre-push --print-linters

set -euo pipefail

GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m'

# validate.yml owns the linter pins. A newer local ruff/hadolint enables
# rules CI does not run and fails code CI accepts, so run the pinned ones.
CI_WORKFLOW=".github/workflows/validate.yml"
if [ ! -f "$CI_WORKFLOW" ]; then
    printf "${RED}pre-push: %s not found (run from the repo root)${NC}\n" "$CI_WORKFLOW" >&2
    exit 1
fi
RUFF_PIN=$(sed -nE 's/.*pip install ruff==([0-9][0-9.]*).*/\1/p' "$CI_WORKFLOW" | head -n 1)
HADOLINT_PIN=$(sed -nE 's/.*HL_VERSION="v?([0-9][0-9.]*)".*/\1/p' "$CI_WORKFLOW" | head -n 1)
if [ -z "$RUFF_PIN" ] || [ -z "$HADOLINT_PIN" ]; then
    printf "${RED}pre-push: cannot read ruff/hadolint pins from %s${NC}\n" "$CI_WORKFLOW" >&2
    exit 1
fi

# Local binary when it already matches the pin, otherwise the pinned
# version via uvx / Docker if that actually runs (uvx can fetch it, the
# Docker daemon answers); empty when neither is usable, so the check is
# skipped with a warning instead of failing the push on a tooling error.
version_core() {
    # "v2.12.0-no-git" -> "2.12.0"
    local v="${1#v}"
    echo "${v%%-*}"
}

resolve_ruff() {
    if command -v ruff >/dev/null 2>&1 \
        && [ "$(version_core "$(ruff --version 2>/dev/null | awk '{print $2}')")" = "$RUFF_PIN" ]; then
        echo "ruff"
    elif command -v uvx >/dev/null 2>&1 && uvx "ruff@$RUFF_PIN" --version >/dev/null 2>&1; then
        echo "uvx ruff@$RUFF_PIN"
    fi
}

resolve_hadolint() {
    if command -v hadolint >/dev/null 2>&1 \
        && [ "$(version_core "$(hadolint --version 2>/dev/null | awk '{print $NF}')")" = "$HADOLINT_PIN" ]; then
        echo "hadolint"
    elif command -v docker >/dev/null 2>&1 && docker info >/dev/null 2>&1; then
        echo "docker run --rm -v \"\$PWD:/w\" -w /w hadolint/hadolint:v$HADOLINT_PIN hadolint"
    fi
}

RUFF_CMD=$(resolve_ruff)
HADOLINT_CMD=$(resolve_hadolint)

if [ "${1:-}" = "--print-linters" ]; then
    printf 'ruff_pin=%s\nhadolint_pin=%s\nruff_cmd=%s\nhadolint_cmd=%s\n' \
        "$RUFF_PIN" "$HADOLINT_PIN" "$RUFF_CMD" "$HADOLINT_CMD"
    exit 0
fi

echo "Running pre-push CI checks..."
echo ""

FAILED=0

run_check() {
    local name="$1"
    local cmd="$2"

    printf "${YELLOW}> ${name}${NC}\n"
    local output
    if output=$(eval "$cmd" 2>&1); then
        printf "${GREEN}  passed${NC}\n"
    else
        printf "${RED}  FAILED${NC}\n"
        printf "%s\n" "$output"
        FAILED=$((FAILED + 1))
    fi
}

# Docker compose syntax
if command -v docker &> /dev/null && [ -f .env ]; then
    run_check "Docker compose syntax" "docker compose config --quiet"
fi

# Shellcheck
if command -v shellcheck &> /dev/null; then
    run_check "Shellcheck (scripts)" "shellcheck -x -S warning scripts/*.sh scripts/**/*.sh client/common/scripts/*.sh client/tests/*.sh"
else
    printf "${YELLOW}  shellcheck not installed - skipping${NC}\n"
fi

# Hadolint
if [ -n "$HADOLINT_CMD" ]; then
    # Same file set as validate.yml: server and client Dockerfiles.
    for f in Dockerfile.* client/common/docker/*/Dockerfile; do
        [ -f "$f" ] || continue
        run_check "Hadolint ($f)" "$HADOLINT_CMD --config .hadolint.yaml --failure-threshold warning $f"
    done
else
    printf "${YELLOW}  hadolint %s unavailable (no matching hadolint, Docker not running) - skipping${NC}\n" "$HADOLINT_PIN"
fi

# Ruff
if [ -n "$RUFF_CMD" ]; then
    run_check "Ruff check" "$RUFF_CMD check docker/metadata-service/ scripts/meta_*.py tests/"
    run_check "Ruff format" "$RUFF_CMD format --check docker/metadata-service/ scripts/meta_*.py tests/"
else
    printf "${YELLOW}  ruff %s unavailable (no matching ruff, uvx cannot fetch it) - skipping${NC}\n" "$RUFF_PIN"
fi

# Python tests
if command -v pytest &> /dev/null; then
    run_check "Python tests" "pytest tests/ -q --tb=short"
else
    printf "${YELLOW}  pytest not installed - skipping${NC}\n"
fi

echo ""
if [ $FAILED -eq 0 ]; then
    printf "${GREEN}All checks passed! Pushing...${NC}\n"
    exit 0
else
    printf "${RED}${FAILED} check(s) failed!${NC}\n"
    echo ""
    echo "Fix the issues or bypass with: git push --no-verify"
    exit 1
fi
